# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings → API / Database) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # pipeline only: never expose to the client
DATABASE_URL=                     # postgres connection string, used by Drizzle

# --- Qdrant ---
QDRANT_URL=http://localhost:6333  # or your Qdrant Cloud cluster URL
QDRANT_API_KEY=                   # empty for local Docker

# --- LLMs ---
OLLAMA_URL=http://localhost:11434 # offline pipeline
OLLAMA_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=                   # live Q&A only

# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Client (Vite exposes only VITE_* vars to the browser) ---
VITE_API_URL=http://localhost:4000
